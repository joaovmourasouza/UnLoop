{
  "id": "io.github.joaovmourasouza.UnLoop",
  "runtime": "org.gnome.Platform",
  "runtime-version": "47",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "unloop",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "build-args": ["--share=network"],
    "env": {
      "CARGO_HOME": "/run/build/unloop/cargo"
    }
  },
  "modules": [
    {
      "name": "unloop",
      "buildsystem": "simple",
      "build-commands": [
        "cargo build --release --locked -p unloop || cargo build --release -p unloop",
        "install -Dm755 target/release/unloop -t /app/bin/",
        "install -Dm644 data/io.github.joaovmourasouza.UnLoop.desktop -t /app/share/applications/",
        "install -Dm644 data/io.github.joaovmourasouza.UnLoop.metainfo.xml -t /app/share/metainfo/",
        "install -Dm644 data/icons/io.github.joaovmourasouza.UnLoop.svg -t /app/share/icons/hicolor/scalable/apps/"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../..",
          "skip": ["target", ".flatpak-builder", "build-dir", "repo"]
        }
      ]
    }
  ]
}
